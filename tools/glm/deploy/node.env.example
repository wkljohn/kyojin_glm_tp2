# /etc/kyojin-ep.env: one per host (systemd EnvironmentFile of kyojin-ep.service). Rank 0 serves HTTP, rank 1 follows.
# Everything except KYOJIN_EP_RANK, NCCL_IB_HCA and the interface names must be identical on both hosts.
# systemd does not strip trailing comments: keep comments on their own lines.

# 0 on the serving host, 1 on the peer
KYOJIN_EP_RANK=0
# RDMA device of the RoCE port on THIS host (ibv_devices), and its netdev (NCCL wants a leading '=' for exact match)
NCCL_IB_HCA=mlx5_0
NCCL_SOCKET_IFNAME==ens1f0np0
GLOO_SOCKET_IFNAME=ens1f0np0
# rank 0's address on the RoCE link (same value on both hosts)
MASTER_ADDR=192.168.99.1
MASTER_PORT=29531
# RoCE v2 IPv4 GID index (show_gids / ibv_devinfo -v); 3 on Ubuntu with one IPv4 address on the port
NCCL_IB_GID_INDEX=3

# install.sh layout; CIRU_ENV is the runtime venv (variable name kept from the original deployment)
CIRU_ENV=/opt/kyojin-glm-tp2/runtime
MODEL=/srv/models/GLM-5.3-Flash-EXL3-4bpw-TensorFold-Ablit
DRAFT=/srv/models/GLM-5.3-Flash-DFlash2

# HTTP, used by rank 0 only. The server has no auth of its own: bind to localhost/LAN and put Caddy (or similar) in front
HOST=127.0.0.1
PORT=8083
MODEL_ID=GLM-5.3-Flash-EXL3-Ablit-TP2
CTX=131072
# e.g. --alias Some-Old-Model-Name (repeatable)
EXTRA_ARGS=
# per-request numbers (never prompt text); the directory must exist and be writable by the service user
KYOJIN_REQLOG_DIR=/var/log/kyojin-ep
# Rank 0's share of the routed experts. Must be identical on both hosts (checked at start), like every KYOJIN_EP_*.
# 0.55 (with the per-call shared-expert balancer below) was measured on the reference pair, whose rank-1 GPU sustains ~17 % less compute; with two equal hosts
# use 0.5. Measure each host with tools/glm/gpu_speed_probe.py (README "Tuning the split").
KYOJIN_EP_SHARE=0.55
# Share of the non-expert splits (KDA heads, dense/shared/drafter channels, vocabulary) used in decode
KYOJIN_EP_SHARE_DENSE=0.53
# Prefill-only splits (stateless parts; decode keeps the splits above): MLA heads 48/16 (needs heads % 16) and the
# shared expert's channels. Tuned on the reference pair (rank-1 GPU ~17 % slower); with two equal hosts use 0.5 / 0.5
KYOJIN_EP_MLA_PF_SHARE=0.75
KYOJIN_EP_SHARED_PF_SHARE=0.63
# Shared expert replicated on both hosts and split per decode call from the routing (balances the ranks; ~0.5 GB per host)
KYOJIN_EP_SHARED_DYN=1
# Lean ctypes RCCL communicator for the decode all-reduces (torch's ~80 us host cost per call removed)
KYOJIN_EP_PYNCCL=1
# 8-bit group-quantized storage for the large BF16 linears (attention, shared expert, dense, head, drafter):
# decode +17-21 %, ~4 GiB less memory per host, logits within the fp16 noise floor (README "Accuracy"). 0 = BF16
KYOJIN_Q8_LINEAR=1
# optional: seconds before a collective one rank never joined aborts the process (default 300)
#KYOJIN_EP_NCCL_TIMEOUT=300
# optional diagnostic: rank 1 logs rounds where its own drafter output differed from rank 0's
#KYOJIN_EP_DRAFT_DEBUG=1
